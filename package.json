{
  "name": "roka-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "stage": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs --dev && astro dev",
    "build": "node scripts/prepare.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "preview:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "fonts:build": "node scripts/build-fonts.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "verify": "node scripts/prepare.mjs && astro build && pagefind --site dist"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.4.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "pagefind": "^1.6.0",
    "wrangler": "^4.156.0"
  }
}
