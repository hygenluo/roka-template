---
/**
 * 游戏外壳：全出血，没有索引栏。
 * 这是全站唯一"没有边距"的页面 —— 版面本身就是"你离开了阅读区"的信号。
 */
import '../styles/fonts.css';
import '../styles/site.css';
import { site } from '../lib/site';
import { themeCss, themeBootstrap } from '../lib/theme';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = `${title} · ${site.title}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline set:html={themeBootstrap()}></script>
    <style is:inline set:html={themeCss()}></style>
    <style is:inline>
      html,
      body {
        height: 100%;
      }
      body {
        margin: 0;
        display: flex;
        flex-direction: column;
        background: var(--paper);
        overflow: hidden;
      }
      .gbar {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 10px clamp(12px, 2vw, 20px);
        border-bottom: 1px solid var(--rule);
        font-size: 12px;
        color: var(--ink-soft);
      }
      .gbar a {
        color: var(--ink);
        text-decoration: none;
        font-family: var(--font-mono);
        font-size: 11.5px;
        letter-spacing: 0.06em;
      }
      .gbar h1 {
        font-size: 12.5px;
        font-weight: 500;
        margin: 0;
        color: var(--ink);
        letter-spacing: 0.04em;
      }
      .gbar__right {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: var(--font-mono);
        font-size: 11px;
      }
      .gbar button {
        appearance: none;
        border: 1px solid var(--rule);
        background: transparent;
        color: var(--ink-soft);
        font: inherit;
        padding: 3px 9px;
        border-radius: var(--radius);
        cursor: pointer;
      }
      .gbar button:hover {
        color: var(--ink);
        border-color: var(--rule-2);
      }
      .stage {
        flex: 1;
        min-height: 0;
        position: relative;
        background: var(--paper-sunk);
      }
      .stage iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
      }
      .gfoot {
        flex: none;
        padding: 7px clamp(12px, 2vw, 20px);
        border-top: 1px solid var(--rule);
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.04em;
        color: var(--ink-soft);
        display: flex;
        justify-content: space-between;
        gap: 12px;
      }
      .gfoot a {
        color: inherit;
      }
      @media (max-width: 620px) {
        .gbar__right span {
          display: none;
        }
      }
    </style>
  </head>
  <body data-pagefind-ignore>
    <slot />
  </body>
</html>
