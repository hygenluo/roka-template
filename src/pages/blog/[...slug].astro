---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import { fmtDate, fmtISODate } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 同一系列里的上一篇/下一篇，比"文章列表前后"更有用
const inSeries = post.data.series
  ? all
      .filter((p) => p.data.series === post.data.series)
      .sort((a, b) => (a.data.seriesOrder ?? 99) - (b.data.seriesOrder ?? 99))
  : all;
const idx = inSeries.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? inSeries[idx - 1] : undefined;
const next = idx >= 0 && idx < inSeries.length - 1 ? inSeries[idx + 1] : undefined;

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout
  progress
  title={post.data.title}
  description={post.data.description}
  stamp={fmtDate(post.data.pubDate)}
>
  <div class="article">
    <div class="article__body">
      <header class="article-head">
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <div class="article-meta">
          <time datetime={fmtISODate(post.data.pubDate)}>{fmtDate(post.data.pubDate)}</time>
          {
            post.data.series && (
              <span>
                系列 {post.data.series} · 第 {post.data.seriesOrder ?? '–'} 篇
              </span>
            )
          }
          {post.data.difficulty && <span>{post.data.difficulty}</span>}
          {post.data.tags.map((t) => (
            <a class="tag" href={`/tags/${t}`}>{t}</a>
          ))}
        </div>
      </header>

      {
        post.data.cover && (
          <figure style="margin:0 0 32px">
            <Img src={post.data.cover} alt={post.data.title} priority sizes="(max-width: 760px) 100vw, 68ch" />
          </figure>
        )
      }

      <article class="prose">
        <Content />
      </article>

      <nav class="pager" aria-label="系列导航">
        <div>
          {prev && <a href={`/blog/${prev.id}`}><span>← 上一篇</span>{prev.data.title}</a>}
        </div>
        <div style="text-align:right">
          {next && <a href={`/blog/${next.id}`}><span>下一篇 →</span>{next.data.title}</a>}
        </div>
      </nav>
    </div>

    <aside class="article__aside">
      {
        toc.length > 0 && (
          <>
            <h2>本篇</h2>
            <ol>
              {toc.map((h) => (
                <li class={`lvl-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </>
        )
      }
    </aside>
  </div>
</BaseLayout>
